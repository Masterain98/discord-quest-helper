{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "mainBinaryName": "meridian",
  "app": {
    "enableGTKAppId": false
  },
  "bundle": {
    "linux": {
      "appimage": {
        "bundleMediaFramework": true,
        "files": {
          "/usr/lib/libsoftokn3.so": "/usr/lib/x86_64-linux-gnu/libsoftokn3.so",
          "/usr/lib/libfreeblpriv3.so": "/usr/lib/x86_64-linux-gnu/libfreeblpriv3.so"
        }
      },
      "deb": {
        "depends": [
          "libssl3",
          "ca-certificates",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ],
        "desktopTemplate": "linux/discord-quest-helper.desktop.hbs"
      }
    }
  }
}
